---
import SEOHead from '../components/SEOHead.astro';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeToggle from '../components/ThemeToggle.tsx';
import '../styles/global.css';

const GTM_ID = import.meta.env.PUBLIC_GTM_ID;

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, canonical, ogImage, type, publishedDate, schema } = Astro.props;
---

<!doctype html>
<html lang="it" data-theme="light" data-accent="forest" data-display="bricolage">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      type={type}
      publishedDate={publishedDate}
      schema={schema}
    />
    <Analytics />
  </head>
  <body>
    {GTM_ID && (
      <noscript set:html={`<iframe src="https://www.googletagmanager.com/ns.html?id=${GTM_ID}" height="0" width="0" style="display:none;visibility:hidden"></iframe>`} />
    )}
    <a href="#main-content" class="skip-link">Vai al contenuto principale</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <ThemeToggle client:visible />

    <script is:inline>
    (function(){
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            observer.unobserve(e.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px 60px 0px' });
      document.querySelectorAll('.reveal, .y2k').forEach(function(el) {
        observer.observe(el);
      });
    })();
    </script>
  </body>
</html>
