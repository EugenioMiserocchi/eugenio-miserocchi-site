---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import portraitImg from '../assets/images/eugenio-miserocchi-web-dev.png';
import serviceWebImg from '../assets/images/servizio-sito-web-home.png';
import serviceAutomationImg from '../assets/images/servizio-ai-automation-home.png';
import serviceDashboardImg from '../assets/images/servizio-dashboard-home.png';
import caseLandingImg from '../assets/images/caso-reale-landing-page.png';
import caseAppPreventiviImg from '../assets/images/caso-reale-app-preventivi.png';
import caseEcommerceImg from '../assets/images/caso-reale-e-commerce.png';
import caseAutomazioneImg from '../assets/images/caso-reale-automazione.png';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Eugenio Miserocchi Sviluppatore Web & Consulente Automazioni',
  description: 'Sviluppo siti web performanti e automazioni intelligenti per aziende, professionisti e freelancer. Base a Rimini, lavoro in tutta Italia.',
  url: 'https://eugeniomiserocchi.it',
  email: 'info@eugeniomiserocchi.it',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rimini',
    addressRegion: 'Emilia-Romagna',
    addressCountry: 'IT',
  },
  areaServed: [
    { '@type': 'City', name: 'Rimini' },
    { '@type': 'Country', name: 'Italia' },
  ],
  serviceType: ['Sviluppo Web', 'Automazione Processi', 'Consulenza AI', 'Siti Web Performanti'],
  sameAs: [
    'https://www.linkedin.com/in/eugeniomiserocchi/',
    'https://github.com/eugeniomiserocchi',
  ],
};
---

<BaseLayout
  title="Sviluppatore Web & Automazioni a Rimini | Eugenio Miserocchi"
  description="Sviluppo siti web performanti e automazioni intelligenti per aziende, professionisti e freelancer. Referente unico, processo chiaro, risultati misurabili. Rimini e tutta Italia."
  ogImage="/images/eugenio-miserocchi-web-dev.png"
  schema={schema}
>

<style>
  .hero{ padding-top:clamp(56px, 8vw, 96px); padding-bottom:var(--section-y) }
  .hero-grid{
    display:grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
    gap:clamp(32px, 5vw, 72px);
    align-items:center;
  }
  @media (max-width: 880px){
    .hero-grid{grid-template-columns:1fr; gap:32px}
    .hero-grid>.portrait-wrap{order:-1}
    .portrait{max-height:340px; aspect-ratio:unset}
    .portrait img{object-position:top}
  }

  .hero h1 em{ font-style:normal; color:var(--accent) }
  .hero-sub{ margin-top:28px; font-size:clamp(17px, 1.35vw, 19.5px); color:var(--muted); max-width:62ch; line-height:1.6 }
  .cta-row{display:flex; gap:14px; flex-wrap:wrap; margin-top:40px}

  .portrait-wrap{ position:relative }
  .portrait{
    position:relative;
    aspect-ratio: 4/5;
    width:100%;
    border-radius:var(--radius-lg);
    overflow:hidden;
    background:
      repeating-linear-gradient(135deg,
        var(--bg-2) 0 14px,
        var(--surface-2) 14px 28px);
    border:1px solid var(--line);
    box-shadow:var(--shadow-card);
  }
  .portrait .imgholder-tag{
    position:absolute; right:14px; top:14px;
    font-family:var(--font-mono); font-size:10.5px; color:var(--ink);
    background:var(--surface); border:1px solid var(--line);
    padding:5px 9px; border-radius:8px;
  }
  .portrait .imgholder-cap{
    position:absolute; left:14px; bottom:14px; right:14px;
    font-family:var(--font-mono); font-size:11px; color:var(--muted);
    background:var(--surface); border:1px solid var(--line);
    padding:7px 10px; border-radius:8px; line-height:1.45;
  }
  .portrait img,
  .portrait picture,
  .svc-img picture,
  .svc-img img{
    width:100%;
    height:100%;
    display:block;
  }
  .portrait img,
  .svc-img img{
    object-fit:cover;
  }
  .badge-rot{
    position:absolute; left:-32px; bottom:-32px;
    width:130px; height:130px;
    border-radius:50%;
    background:var(--accent);
    color:var(--accent-ink);
    display:grid; place-items:center;
    box-shadow:var(--shadow-cta);
  }
  .badge-rot svg{ width:100%; height:100%; animation:spin 18s linear infinite }
  .badge-rot .core{
    position:absolute; inset:0; display:grid; place-items:center;
    font-family:var(--font-display); font-weight:800; font-size:calc(20px * var(--display-scale));
  }
  .badge-rot .core span{
    display:grid; place-items:center;
    width:42px; height:42px; border-radius:50%;
    background:var(--accent-ink); color:var(--accent);
    position:relative;
    overflow:hidden;
  }
  .badge-rot .core-icon{
    position:absolute;
    background-color:currentColor;
    -webkit-mask-position:center;
            mask-position:center;
    -webkit-mask-repeat:no-repeat;
            mask-repeat:no-repeat;
    -webkit-mask-size:contain;
            mask-size:contain;
    transition:opacity 320ms var(--ease), transform 420ms var(--ease);
  }
  .badge-rot .core-icon--compass{
    width:25px;
    height:25px;
    opacity:1;
    transform:scale(1) rotate(0deg);
    -webkit-mask-image:url("/y2k/compass-plus.svg");
            mask-image:url("/y2k/compass-plus.svg");
  }
  .badge-rot .core-icon--orbit{
    width:29px;
    height:16px;
    opacity:0;
    transform:scale(.72) rotate(-8deg);
    -webkit-mask-image:url("/y2k/orbit-eye.svg");
            mask-image:url("/y2k/orbit-eye.svg");
  }
  .badge-rot:hover .core-icon--compass{
    opacity:0;
    transform:scale(.72) rotate(14deg);
  }
  .badge-rot:hover .core-icon--orbit{
    opacity:1;
    transform:scale(1) rotate(0deg);
  }
  @keyframes spin{ to{transform:rotate(360deg)} }
  @media (max-width: 540px){
    .badge-rot{ width:104px; height:104px; left:-16px; bottom:-16px }
  }

  .trust{
    display:flex; align-items:center; justify-content:space-between; gap:32px;
    margin-top:64px; flex-wrap:wrap;
    padding-top:28px; border-top:1px solid var(--line);
  }
  .trust-l{ font-size:13.5px; color:var(--muted); max-width:30ch }
  .trust-r{ display:flex; gap:32px; flex-wrap:wrap; align-items:center }
  .trust-logo{
    font-family:var(--font-display); font-weight:700; font-size:calc(18px * var(--display-scale));
    color:var(--muted); letter-spacing:-0.014em;
    opacity:.7;
  }

  .metrics{ border-top:1px solid var(--line); border-bottom:1px solid var(--line); background:var(--surface-2) }
  .metrics-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:0 }
  @media (max-width: 780px){ .metrics-grid{grid-template-columns:1fr} }
  .metric{ padding:48px clamp(20px,2vw,32px); border-right:1px solid var(--line-2) }
  .metric:last-child{border-right:0}
  @media (max-width: 780px){
    .metric{border-right:0; border-bottom:1px solid var(--line-2)}
    .metric:last-child{border-bottom:0}
  }
  .metric-num{
    font-family:var(--font-display); font-weight:800;
    font-size:calc(clamp(38px, 4.4vw, 56px) * var(--display-scale));
    letter-spacing:-0.028em; line-height:1; color:var(--ink);
  }
  .metric-num small{
    font-size:0.48em; font-weight:700;
    color:var(--muted); letter-spacing:0; margin-left:6px;
  }
  .metric-cap{ margin-top:14px; font-size:14.5px; color:var(--muted); max-width:38ch; line-height:1.55 }

  .process{ background:var(--bg) }
  .steps{
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
    background:var(--line); border:1px solid var(--line);
    border-radius:var(--radius-lg); overflow:hidden;
  }
  @media (max-width:980px){ .steps{grid-template-columns:repeat(2,1fr)} }
  @media (max-width:540px){ .steps{grid-template-columns:1fr} }
  .step{
    background:var(--surface);
    padding:32px 28px 36px;
    display:flex; flex-direction:column; gap:18px;
    min-height:240px;
    position:relative;
    transition:background 280ms var(--ease), color 280ms var(--ease);
  }
  .step h3{ margin-top:6px; transition:color 280ms var(--ease) }
  .step p{ color:var(--muted); font-size:15px; line-height:1.6; transition:color 280ms var(--ease) }
  .step:hover{ background:var(--accent); color:var(--accent-ink) }
  .step:hover .step-n,
  .step:hover h3,
  .step:hover p{ color:var(--accent-ink) }
  .step:hover .step-n{ opacity:0.7 }

  .services{ background:var(--bg-2) }
  .svc-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px }
  @media (max-width:980px){ .svc-grid{grid-template-columns:1fr} }
  .svc{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    overflow:hidden;
    display:flex; flex-direction:column;
    box-shadow:var(--shadow-card);
    transition:transform 280ms var(--ease), box-shadow 280ms var(--ease);
  }
  .svc:hover{ transform:translateY(-3px); box-shadow:0 1px 0 rgba(26,26,24,.04), 0 26px 50px -24px rgba(26,26,24,.28) }
  .svc-img{
    aspect-ratio: 16/9;
    background:
      radial-gradient(120% 80% at 20% 20%, color-mix(in oklab, var(--accent) 20%, var(--surface)) 0%, var(--surface) 60%),
      var(--surface);
    border-bottom:1px solid var(--line);
    position:relative;
    overflow:hidden;
  }
  .svc-img .imgholder-tag{
    position:absolute; left:14px; top:14px;
    font-family:var(--font-mono); font-size:10.5px; color:var(--ink);
    background:var(--surface); border:1px solid var(--line);
    padding:5px 9px; border-radius:8px;
  }
  .svc-body{ padding:28px; display:flex; flex-direction:column; gap:16px; flex:1 }
  .svc-head{ display:flex; align-items:center; justify-content:space-between; gap:14px }
  .svc-num{ font-family:var(--font-mono); font-size:12px; color:var(--muted-2); letter-spacing:0.06em }
  .svc-icon{
    width:36px; height:36px; border-radius:10px;
    background:var(--accent-soft); color:var(--accent);
    display:grid; place-items:center;
  }
  .svc h3{ font-size:22px; letter-spacing:-0.018em }
  .svc p{ color:var(--muted); font-size:15.5px; line-height:1.6; flex:1 }
  .svc-foot{
    margin-top:8px; padding-top:18px;
    border-top:1px solid var(--line-2);
    display:flex; align-items:center; justify-content:space-between;
    font-size:13.5px; color:var(--muted);
  }
  .svc-foot span{ color:var(--ink); font-weight:500 }

  .fit{ background:var(--bg) }
  .fit-grid{ display:grid; grid-template-columns:1fr 1fr; gap:24px }
  @media (max-width:880px){ .fit-grid{grid-template-columns:1fr} }
  .fit-card{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    padding:36px 36px 32px;
    box-shadow:var(--shadow-card);
  }
  .fit-card h3{
    font-size:22px; margin-bottom:24px;
    display:flex; align-items:center; gap:12px;
  }
  .fit-tick{
    width:24px; height:24px; border-radius:50%;
    display:grid; place-items:center; flex:0 0 24px;
    font-size:13px; line-height:1; font-weight:700;
  }
  .fit-yes .fit-tick{ background:color-mix(in oklab, var(--pos) 18%, transparent); color:var(--pos) }
  .fit-no  .fit-tick{ background:color-mix(in oklab, var(--neg) 18%, transparent); color:var(--neg) }
  .fit-list{ list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:18px }
  .fit-list li{
    display:grid; grid-template-columns:22px 1fr; gap:14px;
    color:var(--ink-2); font-size:15.5px; line-height:1.55;
  }
  .fit-list li .ic{
    margin-top:4px;
    width:18px; height:18px; border-radius:50%;
    display:grid; place-items:center; font-size:11px; line-height:1; font-weight:700;
  }
  .fit-yes .fit-list li .ic{ background:color-mix(in oklab, var(--pos) 18%, transparent); color:var(--pos) }
  .fit-no  .fit-list li .ic{ background:color-mix(in oklab, var(--neg) 18%, transparent); color:var(--neg) }

  .cases{ background:var(--bg-2) }
  .case-grid-home{ display:grid; grid-template-columns:repeat(2,1fr); gap:20px }
  @media (max-width:880px){ .case-grid-home{grid-template-columns:1fr} }
  .case{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    overflow:hidden;
    display:flex; flex-direction:column;
    box-shadow:var(--shadow-card);
    transition:transform 280ms var(--ease);
  }
  .case:hover{ transform:translateY(-2px) }
  .case-thumb{
    aspect-ratio: 16/9;
    border-bottom:1px solid var(--line);
    overflow:hidden;
    position:relative;
  }
  .case-thumb img{
    width:100%; height:100%; object-fit:cover;
  }
  .case-body{
    padding:28px 32px 28px;
    display:grid; grid-template-columns: 1fr auto;
    gap:14px 24px; align-items:start;
  }
  .case-cat{
    grid-column:1 / -1;
    font-family:var(--font-body);
    font-size:12.5px; font-weight:500; color:var(--muted);
    letter-spacing:0.02em;
  }
  .case-metric{
    grid-column:1 / -1;
    font-family:var(--font-display); font-weight:800;
    font-size:calc(clamp(28px, 2.8vw, 38px) * var(--display-scale));
    letter-spacing:-0.022em; color:var(--ink); line-height:1;
  }
  .case-desc{ grid-column:1; color:var(--muted); font-size:15.5px; max-width:46ch }
  .case-arr{
    grid-column:2; grid-row:span 2;
    align-self:end; justify-self:end;
    width:42px; height:42px; border-radius:50%;
    border:1px solid var(--line);
    display:grid; place-items:center; color:var(--ink);
    transition:background 240ms var(--ease), color 240ms var(--ease), transform 240ms var(--ease), border-color 240ms var(--ease);
  }
  .case:hover .case-arr{ background:var(--accent); color:var(--accent-ink); border-color:var(--accent); transform:translate(2px,-2px) }

  .insights{ background:var(--bg) }
  .ins-list{ border-top:1px solid var(--line) }
  .ins{
    display:grid;
    grid-template-columns: 56px 1fr auto auto;
    gap:clamp(16px, 2vw, 32px);
    align-items:center;
    padding:28px 4px;
    border-bottom:1px solid var(--line);
    transition:padding 240ms var(--ease);
  }
  .ins:hover{ padding-left:14px; padding-right:14px }
  .ins-n{ font-family:var(--font-mono); font-size:12.5px; color:var(--muted-2) }
  .ins-t{
    font-family:var(--font-display); font-weight:700;
    font-size:calc(clamp(18px, 1.5vw, 22px) * var(--display-scale)); letter-spacing:-0.014em; color:var(--ink);
  }
  .ins-meta{ font-size:13.5px; color:var(--muted); white-space:nowrap }
  .ins-arr{
    width:36px; height:36px; border-radius:50%;
    border:1px solid var(--line);
    display:grid; place-items:center; color:var(--ink);
    transition:background 240ms var(--ease), color 240ms var(--ease), border-color 240ms var(--ease);
  }
  .ins:hover .ins-arr{ background:var(--ink); color:var(--bg); border-color:var(--ink) }
  @media (max-width:680px){ .ins{ grid-template-columns: 40px 1fr auto; gap:14px } .ins-arr{display:none} }

  .final{ background:var(--ink); color:var(--bg) }
  [data-theme="dark"] .final{ background:var(--surface) }
  .final h2{ color:var(--bg) }
  [data-theme="dark"] .final h2{ color:var(--ink) }
  .final-grid{
    display:grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap:clamp(32px, 5vw, 80px); align-items:center;
  }
  @media (max-width:880px){ .final-grid{grid-template-columns:1fr} }
  .final-sub{ margin-top:24px; color:color-mix(in oklab, var(--bg) 72%, transparent); font-size:17.5px; line-height:1.6; max-width:48ch }
  [data-theme="dark"] .final-sub{ color:var(--muted) }
  .final-card{
    background:color-mix(in oklab, var(--bg) 6%, transparent);
    border:1px solid color-mix(in oklab, var(--bg) 14%, transparent);
    border-radius:var(--radius-lg);
    padding:32px 32px 28px;
  }
  [data-theme="dark"] .final-card{ background:var(--bg-2); border-color:var(--line) }
  .final-meta{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:24px }
  .final-meta span{
    font-family:var(--font-body); font-size:13px; font-weight:500;
    padding:6px 12px; border-radius:999px;
    background:color-mix(in oklab, var(--bg) 12%, transparent);
    color:var(--bg);
    border:1px solid color-mix(in oklab, var(--bg) 18%, transparent);
  }
  [data-theme="dark"] .final-meta span{ background:var(--surface-2); color:var(--ink-2); border-color:var(--line) }
  .final .btn-primary{
    background:var(--bg); color:var(--ink);
    box-shadow:0 1px 0 rgba(255,255,255,.4) inset, 0 12px 28px -14px rgba(0,0,0,.5);
    height:58px; padding:0 30px; font-size:16px;
  }
  .final .btn-primary:hover{ background:var(--accent); color:var(--accent-ink) }
  [data-theme="dark"] .final .btn-primary{ background:var(--accent); color:var(--accent-ink) }
  .final-aside{ margin-top:18px; font-size:13.5px; color:color-mix(in oklab, var(--bg) 60%, transparent) }
  [data-theme="dark"] .final-aside{ color:var(--muted) }
</style>

<!-- HERO -->
<section class="hero" aria-labelledby="hero-heading">
  <div class="wrap">
    <div class="hero-grid">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:28px">
          <span class="dot"></span>
          <span>Disponibile per nuovi progetti 2026</span>
        </div>

        <h1 id="hero-heading">
          Sviluppo siti web e automazioni che <em>fanno crescere il tuo business</em>.
        </h1>

        <p class="hero-sub">
          Creo siti performanti, automazioni intelligenti e soluzioni digitali su misura. Per aziende, professionisti e freelancer che cercano un unico referente tecnico, un processo trasparente e risultati concreti. Da Rimini, per tutta Italia.
        </p>

        <div class="cta-row">
          <a class="btn btn-primary" href="/contatti">
            Parliamone
            <svg class="arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-secondary" href="/servizi">
            Scopri come lavoro
          </a>
        </div>

        <div class="trust">
          <div class="trust-l">Lavoro con PMI, agenzie, studi professionali e freelancer in tutta Italia.</div>
          <div class="trust-r">
            <span class="trust-logo">PMI</span>
            <span class="trust-logo">Agenzie</span>
            <span class="trust-logo">Studi</span>
            <span class="trust-logo">Freelancer</span>
          </div>
        </div>
      </div>

      <div class="portrait-wrap reveal">
        <figure class="portrait" aria-label="Ritratto di Eugenio Miserocchi">
          <Picture
            src={portraitImg}
            alt="Eugenio Miserocchi, web developer"
            widths={[360, 520, 720, 920]}
            sizes="(max-width: 880px) 100vw, 44vw"
            quality={80}
            formats={['avif']}
            fallbackFormat="webp"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
        <div class="badge-rot" aria-hidden="true">
          <svg viewBox="0 0 100 100">
            <defs>
              <path id="circ" d="M50,50 m-38,0 a38,38 0 1,1 76,0 a38,38 0 1,1 -76,0" />
            </defs>
            <text font-family="JetBrains Mono, monospace" font-size="9.5" fill="currentColor" letter-spacing="1.2">
              <textPath href="#circ" startOffset="0">DISPONIBILE 2026 · DISPONIBILE 2026 · </textPath>
            </text>
          </svg>
          <div class="core"><span>
            <i class="core-icon core-icon--compass"></i>
            <i class="core-icon core-icon--orbit"></i>
          </span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <span>
      Siti web performanti <i></i> Automazione AI <i></i> Build su misura <i></i> Landing page <i></i> Core Web Vitals <i></i> Integrazione CRM <i></i> Sviluppo custom <i></i>
      Siti web performanti <i></i> Automazione AI <i></i> Build su misura <i></i> Landing page <i></i> Core Web Vitals <i></i> Integrazione CRM <i></i> Sviluppo custom <i></i>
    </span>
  </div>
</div>

<div class="y2k-divider" aria-hidden="true">
  <span class="mark"><i></i><i></i><i></i></span>
</div>

<!-- METRICS -->
<section class="metrics" aria-label="Numeri di sintesi" style="padding-block:0">
  <div class="wrap" style="padding-inline:0">
    <div class="metrics-grid">
      <div class="metric reveal">
        <div class="metric-num">3<small>aree, un unico stack</small></div>
        <p class="metric-cap">Web, automazione e AI integrati dallo stesso referente. Nessun passaggio tra fornitori diversi.</p>
      </div>
      <div class="metric reveal">
        <div class="metric-num">1<small>referente, 4 step</small></div>
        <p class="metric-cap">Analisi, architettura, sviluppo e ottimizzazione. Un solo interlocutore, nessun rimbalzo tra figure diverse.</p>
      </div>
      <div class="metric reveal">
        <div class="metric-num">48h<small>alla proposta</small></div>
        <p class="metric-cap">Dalla call al preventivo con strategia inclusa. Nessuna attesa.</p>
      </div>
    </div>
  </div>
