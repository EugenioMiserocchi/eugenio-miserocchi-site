---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import portraitImg from '../assets/images/eugenio-miserocchi-web-dev.png';
import caseLandingImg from '../assets/images/caso-reale-landing-page.png';
import caseAutomazioneImg from '../assets/images/caso-reale-automazione.png';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Il tuo business digitale ti sta frenando? | Eugenio Miserocchi',
  description: 'Sito che non converte, processi manuali, strumenti scollegati? Ti aiuto a capire dove intervenire e come. Contattami o scarica il check-up digitale gratuito.',
  url: 'https://eugeniomiserocchi.it/check-up-digitale',
  author: {
    '@type': 'Person',
    name: 'Eugenio Miserocchi',
    url: 'https://eugeniomiserocchi.it',
  },
};
---

<BaseLayout
  title="Il tuo business digitale ti sta frenando? | Eugenio Miserocchi"
  description="Sito che non converte, processi manuali, strumenti scollegati? Ti aiuto a capire dove intervenire e come. Contattami o scarica il check-up digitale gratuito."
  canonical="https://eugeniomiserocchi.it/check-up-digitale"
  ogImage="/images/eugenio-miserocchi-web-dev.png"
  schema={schema}
>

<style>
  /* ── hero ── */
  .lp-hero{ padding-top:clamp(56px, 8vw, 96px); padding-bottom:var(--section-y) }
  .lp-hero-grid{
    display:grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap:clamp(32px, 5vw, 72px);
    align-items:center;
  }
  @media (max-width:880px){
    .lp-hero-grid{ grid-template-columns:1fr; gap:36px }
  }
  .lp-hero h1 em{ font-style:normal; color:var(--accent) }
  .lp-hero-sub{
    margin-top:24px; font-size:clamp(17px, 1.35vw, 19.5px);
    color:var(--muted); max-width:56ch; line-height:1.6;
  }

  /* ── lead form card ── */
  .lead-card{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    padding:36px 32px 32px;
    box-shadow:var(--shadow-card);
  }
  .lead-card-head{
    font-family:var(--font-display); font-weight:700;
    font-size:calc(20px * var(--display-scale));
    color:var(--ink); margin-bottom:6px;
  }
  .lead-card-sub{
    font-size:14px; color:var(--muted); margin-bottom:24px; line-height:1.5;
  }
  .lead-card .form-group:last-of-type{ margin-bottom:20px }
  .lead-privacy{
    font-size:12.5px; color:var(--muted-2); margin-top:14px; line-height:1.5; text-align:center;
  }

  /* ── problem section ── */
  .lp-problem{ background:var(--bg-2) }
  .problem-grid{
    display:grid; grid-template-columns:repeat(3,1fr); gap:20px;
  }
  @media (max-width:880px){ .problem-grid{ grid-template-columns:1fr } }
  .problem-card{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    padding:32px 28px;
    box-shadow:var(--shadow-card);
    display:flex; flex-direction:column; gap:14px;
  }
  .problem-icon{
    width:44px; height:44px; border-radius:12px;
    background:color-mix(in oklab, var(--neg) 12%, transparent);
    color:var(--neg);
    display:grid; place-items:center;
  }
  .problem-card h3{ font-size:19px; letter-spacing:-0.014em }
  .problem-card p{ color:var(--muted); font-size:15px; line-height:1.6 }

  /* ── what's inside ── */
  .lp-inside{ background:var(--bg) }
  .inside-grid{
    display:grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap:clamp(32px, 5vw, 72px);
    align-items:start;
  }
  @media (max-width:880px){ .inside-grid{ grid-template-columns:1fr } }
  .inside-list{
    list-style:none; padding:0; margin:0;
    display:flex; flex-direction:column; gap:0;
  }
  .inside-list li{
    display:grid; grid-template-columns:44px 1fr; gap:16px;
    padding:22px 0;
    border-bottom:1px solid var(--line-2);
    align-items:start;
  }
  .inside-list li:first-child{ padding-top:0 }
  .inside-list li:last-child{ border-bottom:0 }
  .inside-n{
    width:44px; height:44px; border-radius:12px;
    background:var(--accent-soft); color:var(--accent);
    display:grid; place-items:center;
    font-family:var(--font-mono); font-size:13px; font-weight:700;
  }
  .inside-list h4{
    font-size:17px; margin-bottom:4px; letter-spacing:-0.01em;
  }
  .inside-list p{
    font-size:14.5px; color:var(--muted); line-height:1.55;
  }
  .inside-sticky{
    position:sticky; top:120px;
  }
  @media (max-width:880px){ .inside-sticky{ position:static } }

  /* ── social proof ── */
  .lp-proof{ background:var(--bg-2) }
  .proof-grid{
    display:grid; grid-template-columns:repeat(2,1fr); gap:20px;
  }
  @media (max-width:880px){ .proof-grid{ grid-template-columns:1fr } }
  .proof-card{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    overflow:hidden;
    box-shadow:var(--shadow-card);
  }
  .proof-thumb{
    aspect-ratio:16/9; border-bottom:1px solid var(--line);
    overflow:hidden;
  }
  .proof-thumb img{ width:100%; height:100%; object-fit:cover }
  .proof-body{ padding:28px 28px 24px }
  .proof-cat{
    font-family:var(--font-body); font-size:12.5px; font-weight:500;
    color:var(--muted); letter-spacing:0.02em; margin-bottom:8px;
  }
  .proof-metric{
    font-family:var(--font-display); font-weight:800;
    font-size:calc(clamp(26px, 2.6vw, 34px) * var(--display-scale));
    letter-spacing:-0.022em; color:var(--ink); line-height:1;
    margin-bottom:10px;
  }
  .proof-body p{ color:var(--muted); font-size:15px; line-height:1.55 }

  /* ── author ── */
  .lp-author{ background:var(--bg) }
  .author-grid{
    display:grid;
    grid-template-columns: 280px 1fr;
    gap:clamp(32px, 5vw, 56px);
    align-items:center;
  }
  @media (max-width:880px){ .author-grid{ grid-template-columns:1fr; gap:28px } }
  .author-photo{
    aspect-ratio:4/5; border-radius:var(--radius-lg);
    overflow:hidden; border:1px solid var(--line);
    box-shadow:var(--shadow-card);
  }
  .author-photo img{ width:100%; height:100%; object-fit:cover }
  .author-name{
    font-family:var(--font-mono); font-size:12px; color:var(--muted-2);
    letter-spacing:0.06em; text-transform:uppercase; margin-bottom:12px;
  }
  .author-grid h3{
    font-size:clamp(22px, 2.2vw, 28px); letter-spacing:-0.018em; margin-bottom:18px;
  }
  .author-grid p{
    color:var(--muted); font-size:16px; line-height:1.65; max-width:52ch;
  }
  .author-chips{
    display:flex; flex-wrap:wrap; gap:8px; margin-top:20px;
  }
  .author-chips span{
    font-family:var(--font-body); font-size:12.5px; font-weight:500;
    padding:6px 12px; border-radius:999px;
    background:var(--accent-soft); color:var(--accent);
    border:1px solid color-mix(in oklab, var(--accent) 18%, transparent);
  }

  /* ── FAQ ── */
  .lp-faq{ background:var(--bg-2) }
  .faq-list{
    max-width:720px; margin:0 auto;
    display:flex; flex-direction:column; gap:0;
  }
  .faq-item{
    border-bottom:1px solid var(--line);
  }
  .faq-item:last-child{ border-bottom:0 }
  .faq-item summary{
    padding:24px 0;
    font-family:var(--font-display); font-weight:600;
    font-size:18px; letter-spacing:-0.012em;
    color:var(--ink);
    cursor:pointer;
    list-style:none;
    display:flex; align-items:center; justify-content:space-between; gap:16px;
  }
  .faq-item summary::-webkit-details-marker{ display:none }
  .faq-item summary::after{
    content:'+'; flex:0 0 auto;
    font-size:22px; font-weight:300; color:var(--muted);
    transition:transform .2s ease;
  }
  .faq-item[open] summary::after{
    content:'−';
  }
  .faq-item .faq-body{
    padding:0 0 24px;
    font-size:15.5px; color:var(--muted); line-height:1.6; max-width:60ch;
  }

  /* ── final CTA ── */
  .lp-final{ background:var(--ink); color:var(--bg) }
  [data-theme="dark"] .lp-final{ background:var(--surface) }
  .lp-final h2{ color:var(--bg) }
  [data-theme="dark"] .lp-final h2{ color:var(--ink) }
  .lp-final-grid{
    display:grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap:clamp(32px, 5vw, 80px); align-items:center;
  }
  @media (max-width:880px){ .lp-final-grid{ grid-template-columns:1fr } }
  .lp-final-sub{
    margin-top:24px; font-size:17.5px; line-height:1.6; max-width:48ch;
    color:color-mix(in oklab, var(--bg) 72%, transparent);
  }
  [data-theme="dark"] .lp-final-sub{ color:var(--muted) }
  .lp-final .lead-card{
    background:color-mix(in oklab, var(--bg) 6%, transparent);
    border-color:color-mix(in oklab, var(--bg) 14%, transparent);
  }
  [data-theme="dark"] .lp-final .lead-card{
    background:var(--bg-2); border-color:var(--line);
  }
  .lp-final .form-input,
  .lp-final .form-textarea{
    background:color-mix(in oklab, var(--bg) 8%, transparent);
    border-color:color-mix(in oklab, var(--bg) 18%, transparent);
    color:var(--bg);
  }
  [data-theme="dark"] .lp-final .form-input,
  [data-theme="dark"] .lp-final .form-textarea{
    background:var(--surface); border-color:var(--line); color:var(--ink);
  }
  .lp-final .form-input::placeholder,
  .lp-final .form-textarea::placeholder{
    color:color-mix(in oklab, var(--bg) 50%, transparent);
  }
  [data-theme="dark"] .lp-final .form-input::placeholder,
  [data-theme="dark"] .lp-final .form-textarea::placeholder{
    color:var(--muted-2);
  }
  .lp-final .form-label{
    color:color-mix(in oklab, var(--bg) 80%, transparent);
  }
  [data-theme="dark"] .lp-final .form-label{ color:var(--muted) }
  .lp-final .lead-card-head{ color:var(--bg) }
  [data-theme="dark"] .lp-final .lead-card-head{ color:var(--ink) }
  .lp-final .lead-card-sub{
    color:color-mix(in oklab, var(--bg) 60%, transparent);
  }
  [data-theme="dark"] .lp-final .lead-card-sub{ color:var(--muted) }
  .lp-final .lead-privacy{
    color:color-mix(in oklab, var(--bg) 45%, transparent);
  }
  [data-theme="dark"] .lp-final .lead-privacy{ color:var(--muted-2) }
  .lp-final .btn-primary{
    background:var(--bg); color:var(--ink);
    box-shadow:0 1px 0 rgba(255,255,255,.4) inset, 0 12px 28px -14px rgba(0,0,0,.5);
  }
  .lp-final .btn-primary:hover{ background:var(--accent); color:var(--accent-ink) }
  [data-theme="dark"] .lp-final .btn-primary{ background:var(--accent); color:var(--accent-ink) }
</style>


<!-- ═══════════ HERO ═══════════ -->
<section class="lp-hero" aria-labelledby="lp-heading">
  <div class="wrap">
    <div class="lp-hero-grid">
      <div class="reveal">
        <div class="eyebrow" style="margin-bottom:28px">
          <span class="dot"></span>
          <span>Consulenza gratuita &middot; Siti, automazioni, AI</span>
        </div>

        <h1 id="lp-heading">
          Il tuo business digitale <em>ti sta frenando</em>?
        </h1>

        <p class="lp-hero-sub">
          Se il sito non converte, i processi ti rubano ore e gli strumenti non parlano tra loro, il problema non è il traffico. È come lavora il tuo ecosistema digitale. Parliamone: ti dico dove intervenire e come.
        </p>

        <div style="display:flex; gap:14px; flex-wrap:wrap; margin-top:36px">
          <a class="btn btn-primary" href="/contatti">
            Parliamo del tuo progetto
            <svg class="arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="btn btn-ghost" href="#check-up" style="font-size:15px">
            Oppure: scarica il check-up gratuito &darr;
          </a>
        </div>
      </div>

      <!-- Lead form — secondary action -->
      <div class="lead-card reveal" id="check-up">
        <div class="lead-card-head">Non sei ancora pronto? Parti dal check-up.</div>
        <p class="lead-card-sub">10 domande, 5 minuti: scarica il PDF gratuito e scopri da solo dove stai perdendo clienti, tempo e margine. Se vorrai approfondire, mi trovi dall'altra parte.</p>

        <form id="lead-form-hero" class="lead-form" novalidate>
          <div class="form-group">
            <label for="hero-nome" class="form-label">Nome *</label>
            <input type="text" id="hero-nome" name="nome" class="form-input" required autocomplete="given-name" placeholder="Il tuo nome" />
          </div>
          <div class="form-group">
            <label for="hero-email" class="form-label">Email *</label>
            <input type="email" id="hero-email" name="email" class="form-input" required autocomplete="email" placeholder="la-tua@email.it" />
          </div>
          <div class="form-group">
            <label for="hero-sito" class="form-label">URL del tuo sito (opzionale)</label>
            <input type="url" id="hero-sito" name="sito" class="form-input" autocomplete="url" placeholder="https://www.tuosito.it" />
          </div>

          <button type="submit" class="btn btn-primary" style="width:100%; justify-content:center">
            Scarica il check-up gratuito
            <svg class="arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>
          <p class="lead-privacy">Zero spam. Nessuna mailing list. Il PDF si scarica subito.</p>
        </form>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════ PROBLEMA ═══════════ -->
<div class="y2k-divider" aria-hidden="true">
  <span class="mark"><i></i><i></i><i></i></span>
</div>

<section class="lp-problem">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <h2>Tre problemi che frenano il business. E che quasi nessuno misura.</h2>
      </div>
      <p>Non servono rivoluzioni. Spesso bastano interventi mirati su ciò che già esiste ma non funziona.</p>
    </div>

    <div class="problem-grid">
      <article class="problem-card reveal">
        <div class="problem-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>Il sito non converte</h3>
        <p>Hai visite ma nessuno compila il form, chiama o compra. Il problema è performance, struttura e CTA mancanti — non il traffico.</p>
      </article>

      <article class="problem-card reveal">
        <div class="problem-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        </div>
        <h3>I processi manuali ti mangiano le ore</h3>
        <p>Email copiate a mano, follow-up dimenticati, dati ricopiati tra fogli e CRM. Ogni ora spesa su task ripetitivi è un'ora sottratta a vendere e servire i clienti.</p>
      </article>

      <article class="problem-card reveal">
        <div class="problem-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <h3>Gli strumenti digitali non parlano tra loro</h3>
        <p>CRM, email, calendario, fatturazione: ognuno vive per conto suo. Dati sparsi, visione parziale, decisioni prese al buio. Integrarli cambia tutto.</p>
      </article>
    </div>
  </div>
</section>


<!-- CTA intermedia -->
<section style="background:var(--bg); padding-block:clamp(32px, 4vw, 48px)">
  <div class="wrap" style="text-align:center">
    <p style="font-size:17px; color:var(--muted); margin-bottom:20px; max-width:52ch; margin-inline:auto; line-height:1.6">Ti riconosci in uno di questi problemi? Posso dirti esattamente dove intervenire.</p>
    <a class="btn btn-primary" href="/contatti">
      Scrivimi, ti rispondo entro 24h
      <svg class="arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
</section>

<!-- ═══════════ COSA CONTIENE ═══════════ -->
<section class="lp-inside">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <h2>10 domande, 3 aree critiche del tuo business.</h2>
      </div>
      <p>Non è teoria: ogni domanda punta a un problema concreto con un impatto misurabile su fatturato e tempo.</p>
    </div>

    <div class="inside-grid">
      <ul class="inside-list reveal">
        <li>
          <div class="inside-n">01</div>
          <div>
            <h4>Sito &amp; Conversione</h4>
            <p>Il tuo sito genera contatti o è una vetrina ferma? Velocità, struttura, CTA: le leve che separano un sito che lavora da uno che esiste e basta.</p>
          </div>
        </li>
        <li>
          <div class="inside-n">02</div>
          <div>
            <h4>Processi &amp; Automazioni</h4>
            <p>Quanto tempo perdi in attività ripetitive? Email, follow-up, data entry: dove un'automazione può restituirti ore ogni settimana.</p>
          </div>
        </li>
        <li>
          <div class="inside-n">03</div>
          <div>
            <h4>Strumenti &amp; Integrazioni</h4>
            <p>I tuoi tool digitali lavorano insieme o ognuno per conto suo? CRM, email, calendario, fatturazione: dove i dati si perdono e le decisioni rallentano.</p>
          </div>
        </li>
      </ul>

      <div class="inside-sticky reveal">
        <div class="lead-card">
          <div class="lead-card-head">Come posso aiutarti</div>
          <p class="lead-card-sub" style="margin-bottom:20px">Analizzo la tua situazione e ti propongo interventi concreti, dal sito alle automazioni. Un solo referente, dall'analisi al deploy.</p>
          <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:14px">
            <li style="display:flex; align-items:start; gap:12px; font-size:15px; color:var(--ink-2); line-height:1.55">
              <span style="flex:0 0 20px; height:20px; border-radius:50%; background:color-mix(in oklab, var(--pos) 18%, transparent); color:var(--pos); display:grid; place-items:center; font-size:11px; font-weight:700; margin-top:2px">&#10003;</span>
              <span>Audit gratuito del tuo sito e dei tuoi processi</span>
            </li>
            <li style="display:flex; align-items:start; gap:12px; font-size:15px; color:var(--ink-2); line-height:1.55">
              <span style="flex:0 0 20px; height:20px; border-radius:50%; background:color-mix(in oklab, var(--pos) 18%, transparent); color:var(--pos); display:grid; place-items:center; font-size:11px; font-weight:700; margin-top:2px">&#10003;</span>
              <span>Priorità d'intervento ordinate per impatto sul fatturato</span>
            </li>
            <li style="display:flex; align-items:start; gap:12px; font-size:15px; color:var(--ink-2); line-height:1.55">
              <span style="flex:0 0 20px; height:20px; border-radius:50%; background:color-mix(in oklab, var(--pos) 18%, transparent); color:var(--pos); display:grid; place-items:center; font-size:11px; font-weight:700; margin-top:2px">&#10003;</span>
              <span>Proposta chiara con tempi e costi — senza impegno</span>
            </li>
          </ul>
          <div style="margin-top:24px">
            <a class="btn btn-primary" href="/contatti" style="width:100%; justify-content:center">
              Parliamo del tuo progetto
              <svg class="arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
          <p style="font-size:13px; color:var(--muted-2); margin-top:14px; text-align:center; line-height:1.5">Preferisci prima farti un'idea da solo? <a href="#check-up" style="color:var(--accent); text-decoration:underline">Scarica il check-up gratuito</a></p>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- ═══════════ SOCIAL PROOF ═══════════ -->
<section class="lp-proof">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <h2>Questi principi, applicati a progetti reali.</h2>
      </div>
      <p>La stessa logica che uso per analizzare il tuo business, applicata a progetti reali. Ecco due risultati concreti.</p>
    </div>

    <div class="proof-grid">
      <article class="proof-card reveal">
        <div class="proof-thumb">
          <Picture
            src={caseLandingImg}
