<script is:inline>
(function(){
  var WEBHOOK = 'https://hook.eu2.make.com/bajcqivlkiad78qvaibdcloi165xu548';

  document.querySelectorAll('.lead-form').forEach(function(form){
    form.addEventListener('submit', function(e){
      e.preventDefault();
      var f = e.target;
      var btn = f.querySelector('button[type="submit"]');
      var nome = f.querySelector('input[name="nome"]').value.trim();
      var email = f.querySelector('input[name="email"]').value.trim();
      var sito = f.querySelector('input[name="sito"]');

      if(!nome || !email) return;

      btn.disabled = true;
      btn.textContent = 'Invio in corso...';

      var payload = {
        nome: nome,
        email: email,
        fonte: 'check-up-digitale-landing',
      };
      if(sito) payload.sito = sito.value.trim();

      fetch(WEBHOOK, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      })
      .then(function(res){
        if(!res.ok) throw new Error('HTTP ' + res.status);
        var a = document.createElement('a');
        a.href = '/valutazione-digitale.pdf';
        a.download = 'valutazione-digitale.pdf';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        f.innerHTML =
          '<div style="text-align:center;padding:24px 0">' +
            '<div style="width:48px;height:48px;border-radius:50%;background:color-mix(in oklab,var(--pos) 18%,transparent);color:var(--pos);display:grid;place-items:center;margin:0 auto 16px;font-size:24px;font-weight:700">&#10003;</div>' +
            '<h3 style="font-family:var(--font-display);font-size:calc(22px * var(--display-scale));margin-bottom:10px;color:inherit">Download in corso!</h3>' +
            '<p style="color:inherit;opacity:0.7;font-size:15px;line-height:1.6">Il PDF si sta scaricando. Se il download non parte, <a href="/valutazione-digitale.pdf" download style="color:var(--accent);text-decoration:underline">clicca qui</a>.</p>' +
          '</div>';
      })
      .catch(function(){
        btn.disabled = false;
        btn.textContent = 'Riprova';
        var err = f.querySelector('.lead-error');
        if(!err){
          err = document.createElement('p');
          err.className = 'lead-error';
          err.style.cssText = 'color:var(--neg);font-size:14px;margin-top:12px;text-align:center';
          f.appendChild(err);
        }
        err.textContent = 'Errore nell\'invio. Riprova o scrivimi a info@eugeniomiserocchi.it';
      });
    });
  });
})();
</script>

