---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 Pagina non trovata | Eugenio Miserocchi"
  description="La pagina che cerchi non esiste o è stata spostata."
>

<style>
  .error-page{
    padding-top:clamp(96px, 14vw, 180px);
    padding-bottom:clamp(96px, 14vw, 180px);
    text-align:center;
  }
  .error-code{
    font-family:var(--font-display);
    font-size:calc(clamp(80px, 12vw, 160px) * var(--display-scale));
    font-weight:800;
    color:var(--accent);
    line-height:1;
    letter-spacing:-0.04em;
    margin-bottom:20px;
  }
  .error-page h1{
    font-size:calc(clamp(24px, 3vw, 36px) * var(--display-scale));
    margin-bottom:16px;
  }
  .error-page p{
    color:var(--muted);
    font-size:17px;
    max-width:48ch;
    margin:0 auto 40px;
    line-height:1.6;
  }
</style>

<section class="error-page">
  <div class="wrap reveal">
    <div class="error-code">404</div>
    <h1>Questa pagina non esiste.</h1>
    <p>Forse il link è cambiato, oppure la pagina è stata rimossa. Torna alla homepage o dai un'occhiata ai miei servizi.</p>
    <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap">
      <a href="/" class="btn btn-primary">
        Torna alla homepage
        <svg class="arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href="/servizi" class="btn btn-secondary">Vedi i servizi</a>
    </div>
  </div>
</section>

</BaseLayout>

