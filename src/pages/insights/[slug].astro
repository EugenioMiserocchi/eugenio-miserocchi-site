---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date,
  author: {
    '@type': 'Person',
    name: 'Eugenio Miserocchi',
    url: 'https://eugeniomiserocchi.it/chi-sono',
  },
  publisher: {
    '@type': 'Person',
    name: 'Eugenio Miserocchi',
  },
  url: `https://eugeniomiserocchi.it/insights/${entry.slug}`,
};
---

<BaseLayout
  title={`${entry.data.title} | Eugenio Miserocchi`}
  description={entry.data.description}
  type="article"
  publishedDate={entry.data.date}
  schema={schema}
>

<style>
  .article-hero{ padding-top:clamp(56px, 8vw, 96px); padding-bottom:clamp(48px, 6vw, 72px) }
  .article-hero h1{ max-width:22ch; margin-bottom:24px }

  .article-meta{
    display:flex; align-items:center; gap:16px; flex-wrap:wrap;
    font-family:var(--font-mono); font-size:12.5px; color:var(--muted-2);
  }
  .article-meta .insight-tag{ font-size:11px }

  .article-body{
    padding-block:var(--section-y);
  }
  .article-body .wrap{
    display:grid;
    grid-template-columns:minmax(0,72ch) 1fr;
    gap:clamp(48px,6vw,96px);
    align-items:start;
  }
  @media (max-width:960px){
    .article-body .wrap{ grid-template-columns:1fr }
  }

  .article-sidebar{
    position:sticky; top:120px;
  }
  .sidebar-block{ margin-bottom:32px }
  .sidebar-block h4{
    font-family:var(--font-mono); font-size:11.5px; font-weight:600;
    color:var(--accent); text-transform:uppercase; letter-spacing:0.08em;
    margin-bottom:14px;
  }
  .sidebar-nav{
    list-style:none; padding:0; margin:0;
    display:flex; flex-direction:column; gap:10px;
  }
  .sidebar-nav a{
    font-size:14px; color:var(--muted);
    transition:color 200ms var(--ease);
  }
  .sidebar-nav a:hover{ color:var(--ink) }

  .back-link{
    display:inline-flex; align-items:center; gap:8px;
    font-size:14px; color:var(--muted);
    transition:color 200ms var(--ease);
    margin-bottom:24px;
  }
  .back-link:hover{ color:var(--ink) }
</style>

<section class="article-hero">
  <div class="wrap reveal">
    <a href="/insights" class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Tutti gli insights
    </a>
    <div class="article-meta" style="margin-bottom:20px">
      <span class="insight-tag">{entry.data.category}</span>
      <span>{entry.data.date}</span>
      <span>{entry.data.readTime}</span>
    </div>
    <h1>{entry.data.title}</h1>
    <p style="color:var(--muted); font-size:clamp(17px, 1.35vw, 19.5px); max-width:62ch; line-height:1.6">
      {entry.data.description}
    </p>
  </div>
</section>

<div class="y2k-divider" aria-hidden="true"><span class="mark"><i></i><i></i><i></i></span></div>

<section class="article-body">
  <div class="wrap">
    <div class="prose reveal">
      <Content />
    </div>

    <aside class="article-sidebar reveal">
      <div class="sidebar-block">
        <h4>In questo articolo</h4>
        <p style="font-size:14px; color:var(--muted); line-height:1.55">
          Scorri l'articolo per esplorare i punti chiave. Per domande o approfondimenti, <a href="/contatti" style="color:var(--accent)">contattami</a>.
        </p>
      </div>

      <div class="sidebar-block" style="background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-lg); padding:24px">
        <h4 style="margin-bottom:12px">Hai un progetto simile?</h4>
        <p style="font-size:14px; color:var(--muted); line-height:1.55; margin-bottom:16px">
          Se vuoi applicare queste idee al tuo business, raccontami il contesto.
        </p>
        <a href="/contatti" class="btn btn-primary" style="width:100%; justify-content:center; height:44px; font-size:14px">
          Parliamone
        </a>
      </div>
    </aside>
  </div>
</section>

<!-- CTA -->
<div class="y2k-divider" aria-hidden="true"><span class="mark"><i></i><i></i><i></i></span></div>
<section style="background:var(--ink); color:var(--bg); padding-block:var(--section-y)">
  <div class="wrap" style="text-align:center; max-width:640px">
    <h2 class="reveal" style="color:var(--bg)">Vuoi parlare di un progetto?</h2>
    <p class="reveal" style="color:color-mix(in oklab, var(--bg) 70%, transparent); margin-top:20px; font-size:17px; line-height:1.6">Raccontami cosa vuoi ottenere. Ti rispondo entro 24 ore lavorative.</p>
    <div class="reveal" style="margin-top:36px">
      <a class="btn btn-primary" href="/contatti" style="background:var(--bg); color:var(--ink)">
        Parliamone
        <svg class="arr" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</section>

</BaseLayout>
