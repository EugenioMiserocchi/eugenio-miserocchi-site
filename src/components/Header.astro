---
const currentPath = Astro.url.pathname;

const nav = [
  { label: 'Servizi', href: '/servizi' },
  { label: 'Chi sono', href: '/chi-sono' },
  { label: 'Casi', href: '/casi-studio' },
  { label: 'Insights', href: '/insights' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<div class="scroll-progress" aria-hidden="true"><span id="scroll-bar"></span></div>

<header class="nav">
  <div class="nav-inner wrap">
    <a href="/" class="brand" aria-label="Eugenio Miserocchi Homepage">
      <div class="brand-mark" aria-hidden="true"></div>
      <span class="brand-name">
        <span>Eugenio</span>
        <span>Miserocchi</span>
      </span>
    </a>

    <nav class="nav-links" aria-label="Navigazione principale">
      {nav.map(item => (
        <a href={item.href} class={isActive(item.href) ? 'current' : ''}>
          {item.label}
        </a>
      ))}

      <a href="/contatti" class="nav-cta">
        Contattami
      </a>

      <button
        class="hamburger"
        type="button"
        id="hamburger-btn"
        aria-label="Apri menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </nav>
  </div>
</header>

<div class="mobile-menu-backdrop" id="mobile-menu-backdrop" hidden></div>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Menu navigazione" aria-hidden="true">
  <div class="mobile-menu-links">
    {nav.map(item => (
      <a href={item.href}>{item.label}</a>
    ))}
  </div>
  <a href="/contatti" class="btn btn-primary">
    Contattami
