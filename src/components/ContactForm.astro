---
// ContactForm form contatto con Netlify Forms (SSG-compatible)
// Netlify gestisce la submission lato infrastruttura, zero JS richiesto.
// Per validazione client-side avanzata, wrappare in React con client:load.

export interface Props {
  heading?: string;
  subheading?: string;
  successMessage?: string;
  netlifyFormName?: string;
}

const {
  heading = 'Contattaci',
  subheading = 'Placeholder descrizione breve del form o dei tempi di risposta.',
  netlifyFormName = 'contatto',
} = Astro.props;
---

<section id="contatti" class="bg-bg section-py" aria-labelledby="contact-heading">
  <div class="container-base">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Intro -->
      <div class="space-y-6">
        <h2
          id="contact-heading"
          class="text-3xl sm:text-4xl font-bold text-text"
          style="font-size: calc(clamp(1.75rem, 4vw, 2.5rem) * var(--display-scale));"
        >
          {heading}
        </h2>
        <p class="text-text-muted leading-relaxed">{subheading}</p>

        <!-- Info contatto placeholder sostituire con dati reali cliente -->
        <ul class="space-y-4 pt-2" aria-label="Informazioni di contatto">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div>
              <p class="text-sm font-medium text-text">Telefono</p>
              <a href="tel:+390000000000" class="text-sm text-text-muted hover:text-primary transition-colors">+39 000 000 0000</a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <div>
              <p class="text-sm font-medium text-text">Email</p>
              <a href="mailto:info@placeholder.com" class="text-sm text-text-muted hover:text-primary transition-colors">info@placeholder.com</a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <div>
              <p class="text-sm font-medium text-text">Indirizzo</p>
              <p class="text-sm text-text-muted">Via Placeholder, 1 00000 Città (XX)</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- Form -->
      <div class="bg-bg-alt rounded-2xl border border-border p-6 sm:p-8">
        <form
          name={netlifyFormName}
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="space-y-5"
          novalidate
        >
          <!-- Netlify hidden fields -->
          <input type="hidden" name="form-name" value={netlifyFormName} />
          <p class="hidden" aria-hidden="true">
            <label>Non compilare: <input name="bot-field" /></label>
          </p>

          <!-- Nome -->
          <div>
            <label for="contact-name" class="block text-sm font-medium text-text mb-1.5">
              Nome e cognome <span class="text-accent" aria-label="campo obbligatorio">*</span>
            </label>
            <input
              type="text"
              id="contact-name"
              name="nome"
              required
              autocomplete="name"
              class="w-full px-4 py-3 rounded-lg border border-border bg-bg text-text placeholder:text-text-muted/60 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-sm"
              placeholder="Mario Rossi"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="contact-email" class="block text-sm font-medium text-text mb-1.5">
              Email <span class="text-accent" aria-label="campo obbligatorio">*</span>
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 rounded-lg border border-border bg-bg text-text placeholder:text-text-muted/60 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-sm"
              placeholder="mario@esempio.it"
            />
          </div>

          <!-- Telefono (opzionale) -->
          <div>
            <label for="contact-phone" class="block text-sm font-medium text-text mb-1.5">
              Telefono <span class="text-text-muted text-xs font-normal">(opzionale)</span>
            </label>
            <input
              type="tel"
              id="contact-phone"
              name="telefono"
              autocomplete="tel"
              class="w-full px-4 py-3 rounded-lg border border-border bg-bg text-text placeholder:text-text-muted/60 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-sm"
              placeholder="+39 000 000 0000"
            />
          </div>

          <!-- Messaggio -->
          <div>
            <label for="contact-message" class="block text-sm font-medium text-text mb-1.5">
              Messaggio <span class="text-accent" aria-label="campo obbligatorio">*</span>
            </label>
            <textarea
              id="contact-message"
              name="messaggio"
              required
              rows="5"
              class="w-full px-4 py-3 rounded-lg border border-border bg-bg text-text placeholder:text-text-muted/60 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors text-sm resize-none"
              placeholder="Come possiamo aiutarti?"
            ></textarea>
          </div>

          <!-- Privacy -->
          <div class="flex items-start gap-3">
            <input
              type="checkbox"
              id="contact-privacy"
              name="privacy"
              required
              class="mt-0.5 w-4 h-4 rounded border-border text-primary focus:ring-primary shrink-0 cursor-pointer"
            />
            <label for="contact-privacy" class="text-xs text-text-muted leading-relaxed cursor-pointer">
              Ho letto e accetto la <a href="/privacy" class="text-primary underline hover:text-primary-light">Privacy Policy</a>.
              I tuoi dati saranno trattati ai sensi del GDPR.
            </label>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            class="w-full py-4 px-8 bg-primary text-white font-semibold rounded-lg hover:bg-primary-light transition-colors duration-200 text-base min-h-[44px]"
          >
            Invia messaggio
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

