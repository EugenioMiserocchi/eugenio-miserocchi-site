<style>
  .foot-legal {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .foot-legal a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .foot-legal a:hover { color: var(--ink); text-decoration: underline; }
  .foot-base {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    text-align: center;
    font-size: 13px;
    color: var(--muted-2);
  }
</style>
