---
// Hero above the fold
// TODO: importare immagine reale con <Image> di Astro:
// import { Image } from 'astro:assets';
// import heroImg from '@/assets/hero.jpg';

export interface Props {
  headline: string;
  subheadline: string;
  ctaPrimaryLabel?: string;
  ctaPrimaryHref?: string;
  ctaSecondaryLabel?: string;
  ctaSecondaryHref?: string;
  // TODO: aggiungere prop image quando disponibile
  // image?: ImageMetadata;
  // imageAlt?: string;
}

const {
  headline = 'Headline principale da sostituire',
  subheadline = 'Sottotitolo esplicativo che accompagna l\'headline. Placeholder da sostituire con copy reale del cliente.',
  ctaPrimaryLabel = 'Azione principale',
  ctaPrimaryHref = '#contatti',
  ctaSecondaryLabel = 'Scopri di più',
  ctaSecondaryHref = '#servizi',
} = Astro.props;
---

<section class="relative bg-bg section-py overflow-hidden" aria-labelledby="hero-heading">
  <!-- Background decorativo opzionale, sostituire con immagine cliente -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-bg pointer-events-none" aria-hidden="true"></div>

  <div class="container-base relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

      <!-- Testo -->
      <div class="order-2 lg:order-1 space-y-6">
        <h1
          id="hero-heading"
          class="text-4xl sm:text-5xl lg:text-6xl font-bold text-text leading-tight"
          style="font-size: calc(clamp(1.9rem, 4.75vw, 3.5rem) * var(--display-scale));"
        >
          {headline}
        </h1>
        <p class="text-lg sm:text-xl text-text-muted leading-relaxed max-w-lg">
          {subheadline}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href={ctaPrimaryHref}
            class="inline-flex items-center justify-center px-8 py-4 bg-primary text-white font-semibold rounded-lg hover:bg-primary-light transition-colors duration-200 text-base min-h-[44px]"
          >
            {ctaPrimaryLabel}
          </a>
          <a
            href={ctaSecondaryHref}
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-border text-text font-semibold rounded-lg hover:border-primary hover:text-primary transition-colors duration-200 text-base min-h-[44px]"
          >
            {ctaSecondaryLabel}
          </a>
        </div>
      </div>

      <!-- Immagine placeholder sostituire con <Image> Astro -->
      <div class="order-1 lg:order-2 relative">
        <div
          class="aspect-[3/2] lg:aspect-[4/3] rounded-2xl bg-bg-alt border border-border flex items-center justify-center"
          aria-hidden="true"
        >
          <div class="text-center text-text-muted">
            <svg class="w-16 h-16 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <p class="text-sm">Immagine hero 800×600px</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

